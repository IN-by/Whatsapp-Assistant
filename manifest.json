{
  "manifest_version": 3,
  "name": "WhatsApp Assistant",
  "version": "1.1",
  "description": "Internal CRM sidebar for WhatsApp Web — quick replies, AI translation, customer lookup and product catalog for CARDSILK team.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://n8n.szcardsilk.com/*"
  ],
  "background": {
    "service_worker": "src/core/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/core/content.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "src/lib/wppconnect-wa.js",
        "src/core/injector.js"
      ],
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "Open CRM Panel"
  }
}